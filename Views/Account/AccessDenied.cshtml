@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4">
            <div class="stat-icon-wrapper icon-critical mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2.5rem;">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Restricted (403)</h2>
            <p class="lead text-muted mb-4">
                You do not possess the required security permissions or clearance to access this resource or manage this incident report.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-house me-1"></i>Return Home
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary px-4">
                        <i class="bi bi-speedometer2 me-1"></i>Admin Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Incident" asp-action="Dashboard" class="btn btn-primary px-4">
                        <i class="bi bi-speedometer2 me-1"></i>My Dashboard
                    </a>
                }
            </div>
        </div>
    </div>
</div>
