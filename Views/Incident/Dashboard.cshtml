@model ReporterDashboardViewModel
@{
    ViewData["Title"] = "Reporter Incident Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold text-dark mb-1">Reporter Incident Dashboard</h2>
        <p class="text-muted mb-0">
            Welcome back, <strong>@Model.ReporterName</strong> &bull; Department: <span class="badge bg-secondary font-monospace">@Model.Department</span>
        </p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Report New Incident
        </a>
    </div>
</div>

<!-- Reporter Metric Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="cyber-stat-card stat-info d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase small fw-bold text-muted">Total Submitted</span>
                <h2 class="fw-bold text-dark mb-0 mt-1">@Model.TotalReported</h2>
            </div>
            <div class="stat-icon-wrapper icon-info">
                <i class="bi bi-folder2-open"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cyber-stat-card stat-primary d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase small fw-bold text-muted">Open / Queued</span>
                <h2 class="fw-bold text-dark mb-0 mt-1">@Model.OpenCount</h2>
            </div>
            <div class="stat-icon-wrapper icon-primary">
                <i class="bi bi-inbox"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cyber-stat-card stat-warning d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase small fw-bold text-muted">Investigating</span>
                <h2 class="fw-bold text-dark mb-0 mt-1">@Model.UnderInvestigationCount</h2>
            </div>
            <div class="stat-icon-wrapper icon-warning">
                <i class="bi bi-search"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cyber-stat-card stat-success d-flex align-items-center justify-content-between">
            <div>
                <span class="text-uppercase small fw-bold text-muted">Resolved / Closed</span>
                <h2 class="fw-bold text-dark mb-0 mt-1">@(Model.ResolvedCount + Model.ClosedCount)</h2>
            </div>
            <div class="stat-icon-wrapper icon-success">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
    </div>
</div>

<!-- Reporter Incident Tracking Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history me-2 text-primary"></i>My Reported Incidents & Tracking History
        </h5>
        <span class="badge bg-light text-dark border">@Model.UserIncidents.Count Record(s)</span>
    </div>

    <div class="card-body p-0">
        @if (Model.UserIncidents.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase font-monospace">
                        <tr>
                            <th class="ps-4">Reference ID</th>
                            <th>Title & Category</th>
                            <th>Severity</th>
                            <th>Current Status</th>
                            <th>Reported On</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UserIncidents)
                        {
                            var severityClass = item.Severity switch
                            {
                                IncidentSeverity.Critical => "badge-severity-critical",
                                IncidentSeverity.High => "badge-severity-high",
                                IncidentSeverity.Medium => "badge-severity-medium",
                                _ => "badge-severity-low"
                            };

                            var statusClass = item.Status switch
                            {
                                IncidentStatus.Submitted => "badge-status-submitted",
                                IncidentStatus.UnderInvestigation => "badge-status-investigation",
                                IncidentStatus.Resolved => "badge-status-resolved",
                                _ => "badge-status-closed"
                            };

                            <tr>
                                <td class="ps-4">
                                    <span class="incident-ref-badge">@item.IncidentReference</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Title</div>
                                    <small class="text-muted"><i class="bi bi-tag me-1"></i>@item.Category</small>
                                </td>
                                <td>
                                    <span class="badge @severityClass px-2 py-1 rounded-pill">
                                        @item.Severity
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @statusClass px-2 py-1 rounded-pill">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-dark">@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                        <i class="bi bi-eye me-1"></i>View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state-box">
                <i class="bi bi-shield-check empty-state-icon text-success"></i>
                <h5 class="fw-bold text-dark">No Incidents Reported Yet</h5>
                <p class="text-muted small mb-3">You have not submitted any cybersecurity incident reports. Click below if you need to report suspicious activity.</p>
                <a asp-action="Create" class="btn btn-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i>Report First Incident
                </a>
            </div>
        }
    </div>
</div>
