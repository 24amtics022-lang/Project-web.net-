@using Microsoft.AspNetCore.Identity
@using IncidentReportingPortal.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");

    <li class="nav-item me-2">
        <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") py-2 px-3 rounded-pill text-uppercase font-monospace">
            <i class="bi @(isAdmin ? "bi-shield-shaded" : "bi-person-check") me-1"></i>
            @(isAdmin ? "Security Admin" : "Reporter")
        </span>
    </li>
    <li class="nav-item dropdown me-2">
        <a class="nav-link dropdown-toggle text-light d-flex align-items-center" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar-circle me-2">
                @(currentUser?.FullName?.Length > 0 ? currentUser.FullName.Substring(0, 1).ToUpper() : "U")
            </div>
            <span class="d-none d-md-inline fw-semibold">@(currentUser?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userMenu">
            <li class="dropdown-header">
                <div class="fw-bold text-dark">@(currentUser?.FullName ?? "Account")</div>
                <small class="text-muted">@User.Identity?.Name</small>
                <div class="text-xs text-primary mt-1">@currentUser?.Department</div>
            </li>
            <li><hr class="dropdown-divider"></li>
            @if (isAdmin)
            {
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Incidents"><i class="bi bi-shield-exclamation me-2"></i>Incident Management</a></li>
            }
            else
            {
                <li><a class="dropdown-item" asp-controller="Incident" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Reporter Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Incident" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Report New Incident</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light px-3" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Secure Login
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-outline-info btn-sm px-3 ms-2 rounded-pill font-monospace" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i>Register
        </a>
    </li>
}
</ul>
