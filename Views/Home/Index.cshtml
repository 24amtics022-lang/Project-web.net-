@{
    ViewData["Title"] = "Cybersecurity Incident Response & Reporting";
}

<div class="row align-items-center py-4 g-4">
    <div class="col-lg-7">
        <div class="d-inline-flex align-items-center bg-white px-3 py-1 rounded-pill shadow-sm mb-3 border">
            <span class="status-indicator-dot me-2"></span>
            <span class="small fw-semibold text-dark">ENTERPRISE INCIDENT DISPATCH 24/7</span>
        </div>
        <h1 class="display-5 fw-bold text-dark lh-sm mb-3">
            Report & Respond to <br />
            <span class="text-primary">Cybersecurity Threats</span> in Real Time
        </h1>
        <p class="lead text-muted mb-4">
            A centralized, role-based platform designed to empower employees to report cyber incidents swiftly, while enabling Security Operations Center (SOC) administrators to triage, investigate, and remediate threats.
        </p>

        <div class="d-flex flex-wrap gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                    </a>
                    <a asp-controller="Admin" asp-action="Incidents" class="btn btn-outline-dark btn-lg px-4">
                        <i class="bi bi-shield-exclamation me-2"></i>Incident Management
                    </a>
                }
                else
                {
                    <a asp-controller="Incident" asp-action="Create" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i>Report An Incident
                    </a>
                    <a asp-controller="Incident" asp-action="Dashboard" class="btn btn-outline-dark btn-lg px-4">
                        <i class="bi bi-speedometer2 me-2"></i>My Reported Incidents
                    </a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login to Report Incident
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Register New Account
                </a>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-lock text-info fs-5 me-2"></i>
                    <span class="fw-semibold font-monospace small">INCIDENT REPORTING QUICK PROTOCOL</span>
                </div>
                <span class="badge bg-danger text-uppercase font-monospace">SOC Alert</span>
            </div>
            <div class="card-body p-4">
                <div class="d-flex mb-3 align-items-start">
                    <div class="badge bg-primary rounded-circle p-2 me-3 mt-1">01</div>
                    <div>
                        <h6 class="fw-bold mb-1">Detect & Isolate</h6>
                        <p class="small text-muted mb-0">Identify suspicious phishing emails, unexpected access logs, or ransomware alerts. Disconnect affected machines from network if instructed.</p>
                    </div>
                </div>

                <div class="d-flex mb-3 align-items-start">
                    <div class="badge bg-primary rounded-circle p-2 me-3 mt-1">02</div>
                    <div>
                        <h6 class="fw-bold mb-1">File Official Incident Report</h6>
                        <p class="small text-muted mb-0">Log in, enter incident details, category, estimated severity, and attach screenshots or logs securely.</p>
                    </div>
                </div>

                <div class="d-flex align-items-start">
                    <div class="badge bg-primary rounded-circle p-2 me-3 mt-1">03</div>
                    <div>
                        <h6 class="fw-bold mb-1">Track Real-time Triage</h6>
                        <p class="small text-muted mb-0">Receive a unique tracking code (e.g. <code>INC-20261021-XXXX</code>) and monitor updates as administrators investigate and resolve the issue.</p>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light p-3 border-top text-center">
                <small class="text-muted"><i class="bi bi-info-circle me-1"></i>All submitted reports are encrypted and audited per security governance policy.</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-2 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center mb-2">
                <div class="stat-icon-wrapper icon-info me-3">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Role-Based Security</h5>
                    <small class="text-muted">Strict Authorization</small>
                </div>
            </div>
            <p class="text-muted small mb-0">Role-governed separation between Reporters and Security Administrators. Cross-tenant tampering is strictly blocked on server.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center mb-2">
                <div class="stat-icon-wrapper icon-warning me-3">
                    <i class="bi bi-file-earmark-medical"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Evidence Handling</h5>
                    <small class="text-muted">Safe Attachment Uploads</small>
                </div>
            </div>
            <p class="text-muted small mb-0">Submit critical evidence logs, screenshots, and payloads with strict file extension filtering and size limitations.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center mb-2">
                <div class="stat-icon-wrapper icon-success me-3">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Investigation Notes</h5>
                    <small class="text-muted">Audited Chronological Log</small>
                </div>
            </div>
            <p class="text-muted small mb-0">SOC investigators post timestamped analysis notes and update incident lifecycles from Submitted through Resolved.</p>
        </div>
    </div>
</div>
